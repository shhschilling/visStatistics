  doi = {10.2307/j.ctvcm4j72},
  urldate = {2026-05-13},
  abstract = {The core methods in today's econometric toolkit are linear regression for statistical control, instrumental variables methods for the analysis of natural experiments, and differences-in-differences methods that exploit policy changes. In the modern experimentalist paradigm, these techniques address clear causal questions such as: Do smaller classes increase learning? Should wife batterers be arrested? How much does education raise wages? {$<$}em{$>$}Mostly Harmless Econometrics shows how the basic tools of applied econometrics allow the data to speak. {$<$}br{$>$}  In addition to econometric essentials, {$<$}em{$>$}Mostly Harmless Econometrics covers important new extensions--regression-discontinuity designs and quantile regression--as well as how to get standard errors right. Joshua Angrist and J\"orn-Steffen Pischke explain why fancier econometric techniques are typically unnecessary and even dangerous. The applied econometric methods emphasized in this book are easy to use and relevant for many areas of contemporary social science.   {$<$}ul{$>$} {$<$}li{$><$}br{$>$} {$<$}li{$>$}An irreverent review of econometric essentials {$<$}li{$><$}br{$>$} {$<$}li{$>$}A focus on tools that applied researchers use most {$<$}li{$><$}br{$>$} {$<$}li{$>$}Chapters on regression-discontinuity designs, quantile regression, and standard errors {$<$}li{$><$}br{$>$} {$<$}li{$>$}Many empirical examples {$<$}li{$><$}br{$>$} {$<$}li{$>$}A clear and concise resource with wide applications {$<$}li{$><$}br{$>$} {$<$}br{$>$} {$<$}br{$>$}},
  isbn = {978-0-691-12034-8},
