  year = 2016,
  month = jan,
  journal = {Journal of Statistical Planning and Inference},
  volume = {168},
  pages = {68--89},
  issn = {0378-3758},
  doi = {10.1016/j.jspi.2015.06.008},
  urldate = {2026-08-05},
  abstract = {Stein's method is a powerful tool for proving central limit theorems along with explicit error bounds in probability theory, where uniform and non-uniform Berry--Esseen bounds spark general interest. Nonlinear statistics, typified by Hoeffding's class of U-statistics, L-statistics, random sums and functions of nonlinear statistics, are building blocks in various statistical inference problems. However, because the standardized statistics often involve unknown nuisance parameters, the Studentized analogues are most commonly used in practice. This paper begins with a brief review of some standard techniques in Stein's method, and their applications in deriving Berry--Esseen bounds and Cram\'er moderate deviations for nonlinear statistics, and then using the concentration inequality approach, establishes Berry--Esseen bounds for Studentized nonlinear statistics in a general framework. As direct applications, sharp Berry--Esseen bounds for Studentized U- and L- statistics are obtained.},
  keywords = {-statistics,Berry--Esseen bound,Cram\'er-type moderate deviation,Nonlinear statistics,Stein's method,Studentized statistics},
  file = {/Users/sschilli/Library/CloudStorage/OneDrive-HochschuleLuzern/storage/322YNN9B/Shao et al. - 2016 - Stein’s method for nonlinear statistics A brief survey and recent progress.pdf;/Users/sschilli/Library/CloudStorage/OneDrive-HochschuleLuzern/storage/6HFPATY5/Shao et al. - 2016 - Stein’s method for nonlinear statistics A brief survey and recent progress.pdf}
